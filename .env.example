# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production

# AI Provider Configuration ('groq' or 'openai')
# Groq is 100% FREE with fast inference and no credit card required!
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI Configuration (Optional fallback if you have active credits)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings: 'local' (100% free offline ONNX MiniLM, ₹0 cost) or 'openai'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration ('gemini', 'groq', or 'openai')
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Storage Configuration
DATABASE_URL=sqlite:///youtube_learning.db
CHROMA_PERSIST_DIR=chroma_db

