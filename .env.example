# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production

# AI Provider Configuration ('groq' or 'openai')
# Groq is 100% FREE with fast inference and no credit card required!
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI Configuration (Optional fallback if you have active credits)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings: 'local' (100% free offline ONNX MiniLM, ₹0 cost) or 'openai'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration ('gemini', 'groq', or 'openai')
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Storage Configuration
DATABASE_URL=sqlite:///youtube_learning.db
CHROMA_PERSIST_DIR=chroma_db

# YouTube Transcript Extraction (cloud deployment workarounds)
# Set YOUTUBE_PROXY to a residential proxy URL (e.g. http://user:pass@host:port)
# so the youtube-transcript-api call can route through it. LangChain's loader
# does NOT honor this var — the app skips it and goes straight to the proxy-aware
# direct API when YOUTUBE_PROXY is set.
#
# RECOMMENDED for Vercel / Lambda / any cloud deployment. Webshare offers 10
# free residential proxies (https://webshare.io).
YOUTUBE_PROXY=

# OPTIONAL: a self-hosted transcript proxy URL. Used as a last-resort fallback
# when YouTube directly blocks AND you have no YOUTUBE_PROXY configured.
# Leave empty unless you run your own transcript service (e.g. a Cloudflare
# Worker wrapping yt-dlp on a residential VPS). Every public free provider
# (lemnoslife, public Invidious, piped, Innertube from cloud IPs) fails for
# cloud deployments — do not enable this unless you have a working endpoint.
TRANSCRIPT_PROVIDER_URL=

# Timeout in seconds for the third-party provider above.
TRANSCRIPT_PROVIDER_TIMEOUT=3

